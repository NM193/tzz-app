{
  "manifest_version": 3,
  "name": "Tzz Collector",
  "version": "1.1.0",
  "description": "Collects the lessons of a Thinkific course as \"Name | link\" lines, ready to paste into Tzz App.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.thinkific.com/*"
  ],
  "action": {
    "default_title": "Tzz Collector",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
